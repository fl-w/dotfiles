{
  "agent": {
    "favorite_models": [],
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "gpt-5.2-codex"
    },
    "model_parameters": []
  },
  "terminal": {
    "dock": "right"
  },
  "icon_theme": "Zed (Default)",
  "autosave": "on_focus_change",
  "project_panel": {
    "hide_hidden": false,
    "default_width": 240,
    "dock": "right",
    "entry_spacing": "comfortable", // Vertical spacing (comfortable, standard)
    "file_icons": true,
    "folder_icons": true,
    // "indent_size": 15, // default 20
    "scrollbar": {
      "show": "never"
    },
    "show_diagnostics": "errors",
    "indent_guides": {
      "show": "always"
    }
  },
  "restore_on_startup": "last_session",
  "redact_private_values": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  // "ui_font_size": 16,
  // "buffer_font_size": 15,
  "theme": {
    "mode": "light",
    "light": "GitHub Light",
    "dark": "Ayu Dark"
  },
  "edit_predictions": {
    "provider": "copilot",
    "copilot": {
      "enable_next_edit_suggestions": false
    },
    "disabled_globs": [],
    "mode": "eager"
  },
  // "agent": {
  //   "default_model": {
  //     "provider": "copilot_chat",
  //     "model": "gpt-4.1"
  //   },
  //   "model_parameters": [],
  //   "enable_feedback": false
  // },

  // "show_completions_on_input": false,
  // "show_completion_documentation": true,
  // "auto_signature_help": true,
  // "show_edit_predictions": true,

  // // Whether to show the signature help after completion or a bracket pair inserted.
  // // If `auto_signature_help` is enabled, this setting will be treated as enabled also.
  // "show_signature_help_after_edits": true,

  "title_bar": {
    "show_branch_icon": false,
    "show_branch_name": true,
    "show_project_items": false,
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false,
    "show_menus": false
  },
  "git": {
    "blame": {
      "show_avatar": false
    },
    "inline_blame": {
      "enabled": true,
      "delay_ms": 0,
      "min_column": 0,
      "padding": 7,
      "show_commit_summary": false
    },
    "hunk_style": "staged_hollow"
  },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false
  },
  "scrollbar": {
    "show": "auto",
    "cursors": true,
    "git_diff": true,
    "selected_symbol": false
  },
  "max_tabs": 10,
  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": false,
    "show_tab_bar_buttons": false
  },
  "tabs": {
    "git_status": false,
    "close_position": "right",
    "show_close_button": "hover",
    "file_icons": false,
    "show_diagnostics": "all"
  },
  "status_bar": {
    "active_language_button": false,
    "cursor_position_button": false,
    "line_endings_button": false
  },
  "global_lsp_settings": {
    "button": true
  },
  "collaboration_panel": {
    "button": false
  },
  "notification_panel": {
    "button": false
  },
  "file_finder": {
    "file_icons": false,
    "include_ignored": "smart"
  },
  "git_panel": {
    "button": false
  },
  "debugger": {
    "dock": "bottom",
    "button": true
  },
  "outline_panel": {
    "button": false
  },
  "auto_install_extensions": {
    "toml": true,
    "kotlin": true
  },
  "node": {
    "path": "~/usr/mise/shims/node",
    "npm_path": "~/usr/mise/shims/npm"
  },
  "languages": {
    "JSONC": {
      "formatter": {
        "external": {
          "command": "/home/fola/usr/pnpm/prettierd",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "/home/fola/usr/pnpm/prettierd",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "TSX": {
      "formatter": {
        "external": {
          "command": "/home/fola/usr/pnpm/prettierd",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    }
  }
}
